{
  "name": "pokedex-diaw",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "concurrently": "concurrently --kill-others --names frontend,backend \"npm run dev\" \"npm run dev:backend\"",
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "mvn -f backend/pom.xml spring-boot:run",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "preview": "npm run preview --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
